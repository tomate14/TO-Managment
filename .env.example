# ---------- Docker ----------
COMPOSE_PROJECT_NAME=to-management

# ---------- Supabase images ----------
SUPABASE_POSTGRES_IMAGE=supabase/postgres:15.8.1.060
SUPABASE_PG_META_IMAGE=supabase/postgres-meta:v0.91.0
SUPABASE_STUDIO_IMAGE=supabase/studio:2025.06.30-sha-6f5982d

# ---------- Red / exposición ----------
# Interfaz del host donde se publican Studio, Postgres y backend (administración). Mantener en loopback.
ADMIN_BIND_ADDRESS=127.0.0.1

# ---------- Database ----------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
APP_DB_SCHEMA=app
# Hosted Supabase: use the host and username from Connect > Session pooler.
# Set POSTGRES_SSLMODE=require for the hosted database.
POSTGRES_SSLMODE=disable
# Only enable for the first connection to a schema initialized with 01_schema.sql (V1..V8).
# Disable again after the first successful backend startup.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_BASELINE_VERSION=8
SUPABASE_DB_VOLUME_NAME=to-management-db-local
# Host folder where the database files live (must exist). Windows: C:/TOManagment
SUPABASE_DB_HOST_PATH=C:/TOManagment
SUPABASE_DB_DATA_PATH=/var/lib/postgresql/data

# ---------- Supabase Studio / postgres-meta (solo administración) ----------
PG_META_PORT=8081
STUDIO_PORT=3001
STUDIO_CONTAINER_PORT=3000
STUDIO_ORGANIZATION_NAME="TO Management"
STUDIO_PROJECT_NAME="TO Management"
STUDIO_SUPABASE_URL=http://localhost
STUDIO_ANON_KEY=not-used
STUDIO_SERVICE_KEY=not-used
STUDIO_JWT_SECRET=change-me-studio-only-never-reuse-jwt-secret

# ---------- Backend ----------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=default
JWT_SECRET=change-me-to-a-64-char-random-hex-string
JWT_EXPIRATION_MS=3600000
APP_TIME_ZONE=America/Argentina/Buenos_Aires
CORS_ALLOWED_ORIGINS=http://localhost:4200
ADMIN_EMAIL=admin@tomanagement.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administradora
REGISTRATION_MAX_PER_HOUR=5

# ---------- Frontend ----------
FRONTEND_PORT=8090
API_BASE_URL=http://backend:${BACKEND_PORT}

# Vercel (production frontend): public backend URL that vercel.json proxies /api/* to.
VERCEL_BACKEND_URL=https://your-backend.a.run.app
