# Access log without query strings: searches like ?q=<DNI> must not end up in the logs (patient data).
log_format privacy '$remote_addr - [$time_local] "$request_method $uri" $status $body_bytes_sent';

server {
    listen ${FRONTEND_PORT};
    root /usr/share/nginx/html;
    index index.html;
    access_log /var/log/nginx/access.log privacy;

    location /api/ {
        resolver 127.0.0.11 valid=10s;
        set $backend_upstream ${API_BASE_URL};
        proxy_pass $backend_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
